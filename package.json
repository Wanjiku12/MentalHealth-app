{
  "name": "mentalhealth-app",
  "version": "1.0.0",
  "description": "A web based system that focuses on mental health",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wanjiku12/MentalHealth-app"
  },
  "scripts": {
    "db": "echo 'Opening Database Server' && cd server && node server.js",
    "start:chatserver": "cd MentalHealth-App && node chatserver.js",
    "start:backend": "start mentalhealth-app/index.html && cd server && node server.js",
    "start:all": "concurrently \"npm run chat\" \"npm run start:backend\"",
    "open:chats": "cd MentalHealth-App && start chat_dashboard.html?chat_identifier=demo1&username=patient1&therapist_id=1&therapist=TherapistA && start chat_dashboard.html?chat_identifier=demo1&username=therapist1&patient_id=1&therapist=TherapistA",
    "chat": "echo 'Opening Patient chat' && cd MentalHealth-App && start chat_dashboard.html && echo 'Opening Therapist chat' &&  start chat_dashboard.html && node chatserver.js"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide": "^0.515.0",
    "mysql2": "^3.14.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "concurrently": "^8.2.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
